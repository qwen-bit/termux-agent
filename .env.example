# ─────────────────────────────────────────────────────────────────────────────
# TermuxAgent — LLM Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# FREE OPTION (recommended — no credit card needed):
#   1. Sign up at https://openrouter.ai  (free)
#   2. Get your API key from https://openrouter.ai/keys
#   3. Set OPENAI_API_KEY to your OpenRouter key below
#   4. The default model below is FREE with no usage limits
#
# FREE models on OpenRouter:
#   google/gemma-3-27b-it:free         (smart, fast — DEFAULT)
#   meta-llama/llama-3.3-70b-instruct:free
#   deepseek/deepseek-r1:free          (great reasoning)
#   mistralai/mistral-7b-instruct:free (lightweight)
#   qwen/qwen3-235b-a22b:free          (large, capable)
#
# PAID OPTION (OpenAI):
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   MODEL=gpt-4o
#
# ─────────────────────────────────────────────────────────────────────────────

OPENAI_API_KEY=your_openrouter_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=google/gemma-3-27b-it:free

# Agent Configuration
MAX_STEPS=20
MEMORY_ENABLED=true
VERBOSE=false
AUTO_APPROVE_SHELL=false

# Termux-specific (set true if termux-api package is installed)
TERMUX_API=false
